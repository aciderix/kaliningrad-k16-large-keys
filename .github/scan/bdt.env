# Tâche du balayage BLUME par recuit (workflow bdt-scan). CMD = arguments de bdt (le mode et ses paramètres).
# B03b (relance) : deux clés, convention directe, w2 = 11..15, w1 = 11..30 (100 paires, 5 par machine),
# 64 recuits × 300 k itérations par paire (calibration : logs/B03b_calibration_grid.out) ; K1 si z(T1) ≥ 12.
JOB=B03b_deux_cles_w2_11_15_x64
CMD=scan data/models/qg_es.bin data/telegram1_615.txt data/telegram2_160.txt 11 30 11 15 64 300000 1
BDT_ENV=BDT_PMI=1 BDT_MV=70,80,90,95,98,99,100 BDT_ZK1=12
