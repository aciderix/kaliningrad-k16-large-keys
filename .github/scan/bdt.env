# Tâche du balayage BLUME par recuit (workflow bdt-scan). CMD = arguments de bdt (le mode et ses paramètres).
# B06 : hypothèse « rectangle de K1 complété » (615 = 15 × 41) → w1 = 15 ; w2 = 16..35 (une largeur par machine),
# 256 recuits × 1 M d'itérations par largeur ; K1 aux quadrigrammes si z(T1) ≥ 12.
JOB=B06_w1_15_rectangle_complet
CMD=scan data/models/qg_es.bin data/telegram1_615.txt data/telegram2_160.txt 15 15 16 35 256 1000000 5
BDT_ENV=BDT_PMI=1 BDT_MV=70,80,90,95,98,99,100 BDT_ZK1=12
