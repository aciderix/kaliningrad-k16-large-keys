# Tâche du balayage BLUME par recuit (workflow bdt-scan). CMD = arguments de bdt (le mode et ses paramètres).
# B03a : clé unique (K1 = K2, type ÜBCHI), w = 11..30 (une largeur par machine), 1000 recuits × 1 M d'itérations.
JOB=B03a_cle_unique
CMD=samescan data/models/qg_es.bin data/telegram1_615.txt data/telegram2_160.txt 11 30 1000 1000000 1
BDT_ENV=BDT_MV=70,80,90,95,98,99,100
