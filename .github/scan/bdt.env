# Tâche du balayage BLUME par recuit (workflow bdt-scan). CMD = arguments de bdt (le mode et ses paramètres).
# B05b : convention lignes-puis-colonnes (C = G_K2(F_K1(P)), I = F_K2(C)), w1 = 11..30 × w2 = 11..30 (400 paires,
# 20 par machine), 8 recuits × 200 k par paire ; K1 aux quadrigrammes si z(T1) ≥ 12.
JOB=B05b_lignes_puis_colonnes
CMD=scan data/models/qg_es.bin data/telegram1_615.txt data/telegram2_160.txt 11 30 11 30 8 200000 1
BDT_ENV=BDT_RC=1 BDT_PMI=1 BDT_MV=70,80,90,95,98,99,100 BDT_ZK1=12
