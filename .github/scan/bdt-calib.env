# Calibration B03b (workflow bdt-calib) : mêmes réglages que le balayage réel, sur espagnol télégraphique planté
# (615 + 160 lettres, mêmes clés aléatoires), 2 plantés × 16 recuits par paire (w1 = 11..30, w2 = 11..15).
JOB=B03b_calibration
CMD=ctrlgrid data/models/qg_es.bin data/heldout/tg_es_58221.txt 615 160 11 30 11 15 2 16 300000 7
BDT_ENV=BDT_PMI=1 BDT_MV=70,80,90,95,98,99,100
