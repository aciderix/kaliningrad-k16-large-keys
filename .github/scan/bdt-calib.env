# B05c : convention inversée, recherche approfondie (64 recuits × 300 k par paire), w1, w2 = 11..40, 900 paires
# réparties sur 20 machines ; étape K1 si z ≥ 14 (bruit observé jusqu'à 13,7 aux grandes largeurs).
JOB=B05c_inversee_profonde
CMD=lagscan2 data/models/qg_es.bin data/telegram1_615.txt data/telegram2_160.txt 0 11 40 11 40 64 300000 3
BDT_ENV=BDT_PMI=1 BDT_MV=70,80,90,95,98,99,100 BDT_ZK1=14
